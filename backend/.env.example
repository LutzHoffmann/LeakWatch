# --- Database ---
POSTGRES_USER=leakwatch
POSTGRES_PASSWORD=leakwatch
POSTGRES_DB=leakwatch
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://leakwatch:leakwatch@postgres:5432/leakwatch

# --- Redis / ARQ ---
REDIS_URL=redis://redis:6379/0

# --- LLM (provider-agnostic: OpenRouter OR ZAI/Zhipu directly) ---
# Primary vars are LLM_*; legacy OPENROUTER_* names are accepted as aliases.
#
# Option A — OpenRouter:
#   LLM_API_KEY=sk-or-...
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=z-ai/glm-5.2
#
# Option B — ZAI international (Coding Plan subscription):
#   The Coding Plan uses a dedicated endpoint with its own quota.
#   LLM_API_KEY=<zai-key>
#   LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
#   LLM_MODEL=glm-5.2
#
# Option C — BigModel (China):
#   LLM_API_KEY=<bigmodel-key>
#   LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   LLM_MODEL=glm-5.2
LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=z-ai/glm-5.2
LLM_TIMEOUT_SECONDS=60

# --- Watchers ---
GITHUB_TOKEN=ghp_...
GITHUB_GIST_POLL_INTERVAL_SECONDS=300
PASTEBIN_POLL_INTERVAL_SECONDS=300

# GitHub Code Search watcher — comma-separated queries. Keep them targeted;
# broad queries are noisy and heavily rate-limited by GitHub.
GITHUB_CODE_SEARCH_QUERIES=password,api_key,BEGIN PRIVATE KEY
GITHUB_CODE_MAX_RESULTS=20

# --- Intelligence X (selector search via the frontend) ---
# API access requires an paid IntelX subscription (Professional/Enterprise).
# Get a key at https://intelx.io/account?tab=developer
INTELX_API_KEY=
INTELX_BASE_URL=https://2.intelx.io

# Pwned Passwords (free, no key) — SHA-1 k-anonymity range search.
PWNED_BASE_URL=https://api.pwnedpasswords.com

# --- API server (FastAPI) ---
# Comma-separated list of allowed CORS origins for the frontend.
API_CORS_ORIGINS=http://localhost:3000

# --- Alerting ---
RESEND_API_KEY=re_...
ALERT_FROM_EMAIL=alerts@leakwatch.local
ALERT_TO_EMAIL=you@example.com

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

ALERT_WEBHOOK_URL=
